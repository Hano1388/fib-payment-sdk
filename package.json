{
  "name": "fib-payment-sdk",
  "version": "1.0.0",
  "description": "Node.js client for the Fib Payment API (OAuth2, payments, status, cancel, refund)",
  "author": "Hindreen Bag",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fib",
    "payment",
    "sdk",
    "iraq",
    "openapi-connect"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.7.2"
  }
}
